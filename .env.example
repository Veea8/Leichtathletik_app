# Kopiere diese Datei zu ".env" und trage die Werte aus deinem
# Supabase-Projekt ein (Dashboard > Project Settings > API).
# Der "anon public" Key ist für die App gedacht — Sicherheit kommt
# aus den Row-Level-Security-Policies, nicht aus dem Key.
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-KEY
